% gait_library(1,4).Delta_Pose = delta_pose_robo;
%
% delta_pose_mat = [ cos(delta_pose_robo(3)), -sin(delta_pose_robo(3)), delta_pose_robo(1) ; ...
%     sin(delta_pose_robo(3)), cos(delta_pose_robo(3)), delta_pose_robo(2) ; ...
%     0, 0, 1 ];
